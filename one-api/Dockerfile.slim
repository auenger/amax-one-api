FROM alpine:3.19

RUN apk add --no-cache ca-certificates tzdata python3 py3-pip nodejs npm

# Install uv (Python package manager) and pre-cache minimax MCP
RUN pip install --no-cache-dir --break-system-packages uv && \
    uv tool install minimax-coding-plan-mcp

# Pre-cache mcp-proxy and zai-mcp-server
RUN npm install -g mcp-proxy @z_ai/mcp-server

COPY bin/aihub-linux /opt/aihub/aihub
COPY entrypoint.sh /opt/aihub/entrypoint.sh
RUN chmod +x /opt/aihub/aihub /opt/aihub/entrypoint.sh

EXPOSE 3000 8765 8766
WORKDIR /data
ENTRYPOINT ["/opt/aihub/entrypoint.sh"]
