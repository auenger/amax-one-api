# Database (used by aihub via docker-compose)
DATABASE_URL=postgresql://aihub:aihub@localhost:5432/aihub

# Redis (used by aihub via docker-compose)
REDIS_URL=redis://localhost:6379

# aihub (AI management platform)
AIHUB_BASE_URL=http://localhost:3000
AIHUB_ROOT_TOKEN=sk-aihub-root-token-change-me

# aihub DSN for local development (no docker)
# SQL_DSN=postgres://aihub:aihub@localhost:5432/aihub?sslmode=disable
# REDIS_CONN_STRING=redis://localhost:6379

# MCP services (optional — only start when API key is set)
# MINIMAX_API_KEY=sk-cp-xxx
# MINIMAX_API_HOST=https://api.minimaxi.com
# MINIMAX_MCP_PORT=8765
# Z_AI_API_KEY=xxx.xxx
# Z_AI_MODE=ZHIPU
# Z_AI_MCP_PORT=8766
