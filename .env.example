# Database (used by one-api via docker-compose)
DATABASE_URL=postgresql://aihub:aihub@localhost:5432/aihub

# Redis (used by one-api via docker-compose)
REDIS_URL=redis://localhost:6379

# one-api (forked proxy engine)
ONE_API_BASE_URL=http://localhost:3000
ONE_API_ROOT_TOKEN=sk-aihub-root-token-change-me

# one-api DSN for local development (no docker)
# SQL_DSN=postgres://aihub:aihub@localhost:5432/aihub?sslmode=disable
# REDIS_CONN_STRING=redis://localhost:6379
