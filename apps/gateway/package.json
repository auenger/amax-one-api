{
  "name": "@aihub/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "API Gateway for AIHub",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
