    "lint": "eslint src/"
  },
  "dependencies": {
    "@aihub/shared": "workspace:*",
    "@aihub/database": "workspace:*",
    "fastify": "^5.3.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "zod": "^3.24.0",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "vitest": "^3.1.0"
  }
}
