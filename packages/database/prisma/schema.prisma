// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// Model Registry — Provider, Key, Model, Alias, SyncLog
// ============================================================

/// LLM 供应商配置
model Provider {
  id         String   @id @default(cuid())
  name       String   @unique
  type       ProviderType
  endpoint   String
  status     ProviderStatus @default(active)
  rateLimits Json?    @map("rate_limits")
  newApiChannelId String? @map("new_api_channel_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  keys        ProviderKey[]
  models      Model[]
  syncLogs    ChannelSyncLog[]

  @@map("providers")
}

/// 供应商真实密钥 (加密存储)
model ProviderKey {
  id           String   @id @default(cuid())
  providerId   String   @map("provider_id")
  encryptedKey String   @map("encrypted_key")
  keyPrefix    String   @map("key_prefix")
  weight       Int      @default(100)
  status       KeyStatus @default(active)
  lastUsedAt   DateTime? @map("last_used_at")
  createdAt    DateTime @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@map("provider_keys")
}

/// 模型定义
model Model {
  id            String   @id @default(cuid())
  providerId    String   @map("provider_id")
  name          String   @unique
  displayName   String?  @map("display_name")
  capabilities  String[] @default([])
  contextWindow Int?     @map("context_window")
  pricing       Json?    // { input_per_1k, output_per_1k }
  status        ModelStatus @default(active)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  aliases  ModelAlias[]

  @@index([providerId])
  @@index([status])
  @@map("models")
}

/// 模型别名 (1:1 映射)
model ModelAlias {
  id        String   @id @default(cuid())
  alias     String   @unique
  modelId   String   @map("model_id")
  createdAt DateTime @default(now()) @map("created_at")

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@map("model_aliases")
}

/// Channel 同步日志
model ChannelSyncLog {
  id              String   @id @default(cuid())
  providerId      String   @map("provider_id")
  action          SyncAction
  newApiChannelId String?  @map("new_api_channel_id")
  status          SyncStatus
  error           String?
  createdAt       DateTime @default(now()) @map("created_at")

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("channel_sync_logs")
}

// ============================================================
// Auth Pool — Virtual Key, AuditLog
// ============================================================

/// Virtual Key — 用户访问平台的虚拟密钥
model VirtualKey {
  id          String   @id @default(cuid())
  name        String
  keyHash     String   @map("key_hash")
  keyPrefix   String   @map("key_prefix")
  scopes      String[] @default([])
  rateLimits  Json?    @map("rate_limits")   // { rpm: number, tpm: number }
  budget      Json?    // { token_limit: number, reset_at: ISO string }
  status      VirtualKeyStatus @default(active)
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  auditLogs AuditLog[]

  @@unique([keyPrefix])
  @@index([keyHash])
  @@index([status])
  @@map("virtual_keys")
}

/// 审计日志
model AuditLog {
  id           String   @id @default(cuid())
  action       String   // e.g. "virtual_key.created", "virtual_key.revoked"
  resourceType String   @map("resource_type")  // e.g. "virtual_key"
  resourceId   String   @map("resource_id")
  detail       Json?    // Additional context
  operator     String?  // Who performed the action (admin, system)
  createdAt    DateTime @default(now()) @map("created_at")

  virtualKey VirtualKey? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// Usage Metering — UsageLog
// ============================================================

/// Token 用量日志 — 记录每次 API 请求的 token 消耗
model UsageLog {
  id               String       @id @default(cuid())
  virtualKeyId     String       @map("virtual_key_id")
  providerId       String?      @map("provider_id")
  modelId          String?      @map("model_id")
  modelName        String       @map("model_name")
  promptTokens     Int          @map("prompt_tokens")
  completionTokens Int          @map("completion_tokens")
  totalTokens      Int          @map("total_tokens")
  requestId        String       @unique @map("request_id")
  requestType      RequestType  @map("request_type")
  status           UsageStatus
  errorCode        String?      @map("error_code")
  latencyMs        Int          @map("latency_ms")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@index([virtualKeyId, createdAt])
  @@index([providerId, createdAt])
  @@index([modelId, createdAt])
  @@index([createdAt])
  @@map("usage_logs")
}

// ============================================================
// Enums
// ============================================================

enum ProviderType {
  openai
  anthropic
}

enum ProviderStatus {
  active
  degraded
  disabled
}

enum KeyStatus {
  active
  disabled
}

enum ModelStatus {
  active
  deprecated
  hidden
}

enum SyncAction {
  create_channel
  update_channel
  delete_channel
}

enum SyncStatus {
  success
  failed
}

enum VirtualKeyStatus {
  active
  revoked
}

enum RequestType {
  chat
  embedding
}

enum UsageStatus {
  success
  error
}
