
{
  "$schema": "https://raw.githubusercontent.com/neuro-syntax/ide/main/config-schema.json",
  "project": {
    "name": "enterprise-ai-control-plane",
    "displayName": "企业级 AI 控制平台",
    "version": "0.1.0",
    "description": "统一治理架构：大语言模型、智能资产与代理编排的企业级中枢控制系统"
  },
  "architecture": {
    "pattern": "Control Plane / Hub-and-Spoke",
    "style": "Microservices with API Gateway",
    "domains": [
      {
        "name": "api-gateway",
        "displayName": "统一 API 网关",
        "responsibility": "协议转换、动态路由、负载均衡、故障降级",
        "techStack": ["TypeScript", "Node.js", "Fastify"],
        "ports": ["rest-api", "grpc", "websocket"]
      },
      {
        "name": "auth-service",
        "displayName": "鉴权与身份服务",
        "responsibility": "Virtual Key 管理、RBAC、OIDC/SSO 集成",
        "techStack": ["TypeScript", "Node.js", "Passport.js"],
        "ports": ["rest-api"]
      },
      {
        "name": "billing-service",
        "displayName": "经济治理服务",
        "responsibility": "Token 计量、预算控制、成本分摊、预测告警",
        "techStack": ["Python", "FastAPI", "Celery"],
        "ports": ["rest-api", "async-worker"]
      },
      {
        "name": "asset-registry",
        "displayName": "资产注册中心",
        "responsibility": "Skill/Agent/Tool 的版本化管理、发现与复用",
        "techStack": ["TypeScript", "Node.js", "PostgreSQL"],
        "ports": ["rest-api", "graphql"]
      },
      {
        "name": "execution-runtime",
        "displayName": "沙箱执行环境",
        "responsibility": "代码执行隔离、瞬时容器管理、网络策略",
        "techStack": ["Rust", "Go", "Firecracker/gVisor"],
        "ports": ["grpc", "internal-rpc"]
      },
      {
        "name": "audit-service",
        "displayName": "审计与护栏服务",
        "responsibility": "不可篡改日志、Guardrails 内容审查、全链路追踪",
        "techStack": ["Python", "FastAPI", "Elasticsearch"],
        "ports": ["rest-api", "stream-consumer"]
      }
    ]
  },
  "database": {
    "primary": {
      "engine": "PostgreSQL 16",
      "orm": "Prisma (TS) / SQLAlchemy (Py)",
      "purpose": "用户、权限、资产元数据、配置"
    },
    "cache": {
      "engine": "Redis 7",
      "purpose": "Token 配额缓存、会话、实时计数器"
    },
    "analytics": {
      "engine": "TimescaleDB / ClickHouse",
      "purpose": "审计日志、用量时序数据、成本趋势"
    },
    "document": {
      "engine": "MinIO / S3",
      "purpose": "Skill 包存储、Agent 快照、不可变审计归档"
    }
  },
  "security": {
    "authProtocol": "OAuth 2.0 / OIDC / SAML",
    "keyManagement": "HashiCorp Vault / AWS KMS",
    "sandboxStrategy": "tiered",
    "sandboxTiers": [
      { "name": "low-risk", "runtime": "docker", "isolationLevel": "software" },
      { "name": "standard", "runtime": "gvisor", "isolationLevel": "kernel-intercept" },
      { "name": "high-risk", "runtime": "firecracker", "isolationLevel": "hardware-virtualization" }
    ],
    "guardrails": {
      "inputFilter": ["pii-detection", "prompt-injection", "secret-scanning"],
      "outputFilter": ["hallucination-detect", "toxicity-check", "data-leak-prevent"]
    },
    "compliance": ["SOC2-Type-II", "GDPR", "ISO-27001", "MLPS-Level-3"]
  },
  "observability": {
    "tracing": "OpenTelemetry + Jaeger",
    "metrics": "Prometheus + Grafana",
    "logging": "Structured JSON → Loki/Elasticsearch",
    "alerting": "PagerDuty / 钉钉 / 飞书"
  },
  "deployment": {
    "orchestration": "Kubernetes (K8s)",
    "serviceMesh": "Istio / Linkerd",
    "ciCd": "GitHub Actions + ArgoCD",
    "regions": ["primary", "dr-backup"]
  },
  "frontend": {
    "framework": "Next.js 14 (App Router)",
    "uiLibrary": "shadcn/ui + Radix UI",
    "styling": "TailwindCSS 4",
    "stateManagement": "TanStack Query + Zustand",
    "visualization": "React Flow (编排画布) + ECharts (监控大盘)"
  },
  "conventions": {
    "apiStyle": "RESTful + Async (Webhook/SSE)",
    "errorFormat": "RFC 7807 Problem Details",
    "idFormat": "ULID (有序唯一标识)",
    "versioning": "URL Path (/v1/)",
    "pagination": "Cursor-based",
    "i18n": true,
    "defaultLocale": "zh-CN"
  },
  "references": {
    "openSource": ["LiteLLM", "One-API", "Dify", "gVisor", "Firecracker"],
    "commercial": ["Google Vertex AI", "Azure AI Foundry", "AWS Bedrock", "Kong AI Gateway"],
    "standards": ["OpenAPI 3.1", "JSON Schema 2020-12", "CloudEvents 1.0"]
  }
}
